# WAHA Security Credentials
WAHA_API_KEY=replace_with_strong_random_hex_secret
WAHA_DASHBOARD_USER=admin
WAHA_DASHBOARD_PASSWORD=replace_with_strong_dashboard_password

# Gemini / Vertex AI Configuration
# Recommended on GCE: set USE_VERTEX_AI=true to authenticate automatically via the VM's Service Account (no API key needed)
USE_VERTEX_AI=true
GCP_PROJECT_ID=
GCP_LOCATION=global
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
SYSTEM_PROMPT=You are a helpful, concise personal AI assistant replying via WhatsApp.

# Self-Chat ("Message Yourself") JID — auto-detected from WAHA session if left blank
SELF_CHAT_ID=
SELF_LID_PREFIX=

# Bot Filtering & Safety Guardrails
# Comma-separated list of WhatsApp chat IDs (e.g., 41791234567@c.us) allowed to trigger auto-replies without prefix
ALLOWED_CHAT_IDS=
# Allow auto-replies when messaging yourself ("Message Yourself" chat)
ALLOW_SELF_CHAT=true
# Messages starting with this prefix (case-insensitive) trigger an immediate Gemini auto-reply
TRIGGER_PREFIX=!ai

# Rate Limits (Anti-Ban Guardrails)
MAX_REPLIES_PER_MINUTE=6
MAX_REPLIES_PER_HOUR=40
CONTEXT_WINDOW_MESSAGES=12

# Optional: Google Sheet ID for two-way sync with Gemini Workspace Assistant
# Share the Google Sheet (Editor permission) with your Compute Engine service account email
GOOGLE_SHEET_ID=
SHEETS_POLL_INTERVAL_SECONDS=20

